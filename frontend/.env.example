# Copy to frontend/.env.local (gitignored). Leave VITE_API_BASE_URL empty to use same-origin /api.
VITE_API_BASE_URL=
# Where the Vite dev proxy forwards /api (read by vite.config.ts, not exposed to the browser)
API_PROXY_TARGET=http://localhost:8000

# Optional error monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0
