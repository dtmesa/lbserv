# Copy to backend/.env (gitignored). All values are local-development defaults.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lbserv
API_KEY=dev-api-key
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Optional error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
